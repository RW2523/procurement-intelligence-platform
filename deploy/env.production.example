# → .env.production at the repo root on the EC2 box.
# AWS + OpenRouter only. No Supabase, no Vercel.

# ---- Database: the SAME Amazon RDS instance and database as the timesheet app,
#      so one login works for both (shared public.auth_users).
DATABASE_URL=postgresql://tsadmin:PASSWORD@your-db.rds.amazonaws.com:5432/timesheet
PG_POOL_MAX=4

# ---- Shared session: MUST be byte-identical to the timesheet app's value,
#      or its cookie won't verify here and nobody can sign in.
AUTH_JWT_SECRET=SAME_VALUE_AS_THE_TIMESHEET_APP

# Where to send someone who isn't signed in (the timesheet app owns login).
#
# BOTH ARE BAKED AT BUILD TIME and both are handed to NextResponse.redirect()
# (src/proxy.ts, src/app/auth/signout/route.ts), which demands an absolute URL —
# so they cannot be made relative, and changing the site's URL means a full
# `next build` here, not a restart. Same origin as the timesheet app, always.
#   pre-cutover:  http://<EC2-public-IP>/login
#   post-cutover: https://<hostname>/login
# deploy/scripts/enable-https.sh (in the timesheet repo) rewrites both and
# rebuilds. Do not edit them by hand mid-cutover.
NEXT_PUBLIC_LOGIN_URL=http://REPLACE_EC2_IP/login
NEXT_PUBLIC_LOGOUT_URL=http://REPLACE_EC2_IP/login

# Read at BUILD time by next.config.ts to decide whether to send HSTS and COOP.
#
# ⚠ EDITING THIS LINE ALONE CHANGES NOTHING while install.sh is the deploy path.
# THE TIMESHEET'S VALUE WINS. Not this file's.
#
# install.sh (in the timesheet repo) does `set -a; . <timesheet>/.env.production;
# set +a` before it builds and starts THIS app, so COOKIE_SECURE is already in
# process.env by the time `next build` runs here — and Next never lets a .env
# file overwrite a key that is already in the environment. The load order is
# documented in node_modules/next/dist/docs/01-app/02-guides/environment-
# variables.md ("looked up in the following places, in order, stopping once the
# variable is found": process.env first, .env.production fourth), and the
# installed loader does exactly that — node_modules/@next/env/dist/index.js
# skips any key already present in its snapshot of the original process.env.
# The same is true for every other key BOTH templates set — as shipped that is
# AUTH_JWT_SECRET, DATABASE_URL, NODE_ENV, OPENROUTER_API_KEY, PG_POOL_MAX,
# STORAGE_S3_BUCKET and STORAGE_S3_REGION. Note PG_POOL_MAX in particular: 4 in
# this template, 5 in the timesheet's, and src/lib/db/pg.ts reads it from
# process.env — so started by install.sh + pm2 this app pools 5. install.sh
# lists every key whose two values disagree, and it is the timesheet's value
# each one is built and run with.
#
# The REST of this file is not inert. Keys the timesheet's .env.production does
# not set — NEXT_PUBLIC_LOGIN_URL / NEXT_PUBLIC_LOGOUT_URL,
# NEXT_PUBLIC_BASE_PATH, STORAGE_S3_PREFIX, OPENROUTER_BASE_URL, CRON_SECRET,
# SAM_GOV_API_KEY, PLAYWRIGHT_ENABLED, PORT — are read from here as normal, and
# enable-https.sh writes the two NEXT_PUBLIC_*_URL values into this app's own
# .env.production during a cutover. Only the shared keys above are overridden.
#
# That precedence is CORRECT and deliberate, not a leak waiting to be plugged.
# The two apps are ONE origin behind Caddy and share ONE session cookie, which
# the timesheet issues (lib/aws/auth.js). "Is this origin HTTPS?" has exactly one
# true answer, and the app that sets the cookie owns it. Two different answers
# would be a silent bug: this app's HSTS/COOP block reads COOKIE_SECURE at BUILD
# time (next.config.ts), so a wrong value here would drop headers, not error.
#
# TO CHANGE IT: edit <timesheet>/.env.production — false on plain HTTP, true on
# HTTPS — and re-run install.sh. Step [5b] then rewrites COOKIE_SECURE in THIS
# APP'S .env.production (the copy on the box that was made from this template)
# to match, and says so in its output, so the file on disk always shows what is
# actually in effect.
# Do not flip it by hand for an HTTPS cutover either way:
# deploy/scripts/enable-https.sh does it in the one order that is safe
# (certificate proven first). See the timesheet's deploy/docs/HTTPS-CUTOVER.md.
#
# Keep the line accurate all the same. It is what this file shows a human, and
# it is the value a `npm run build` run BY HAND in this directory — without
# install.sh's exported environment — actually builds with.
COOKIE_SECURE=false

# ---- S3: the SAME bucket, under its own prefix so nothing collides with
#      the timesheet's ts-uploads/.
STORAGE_S3_BUCKET=REPLACE_bucket_name
STORAGE_S3_REGION=us-east-2
STORAGE_S3_PREFIX=proc-docs

# ---- AI (OpenRouter — the only thing that leaves AWS)
OPENROUTER_API_KEY=sk-or-REPLACE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Crawl trigger. REQUIRED: /api/cron refuses to run without it.
CRON_SECRET=REPLACE_random_hex

# Federal source (free key at sam.gov)
SAM_GOV_API_KEY=

# Playwright stays OFF: the one connector that can use it falls back to a
# static fetch, and a headless Chromium would not fit beside the timesheet app
# on a 2 GB box.
PLAYWRIGHT_ENABLED=false

# Mount point. MUST match the Caddy route. Client fetch() calls are prefixed
# with this (see src/lib/apiPath.ts) — Next does not rewrite fetch URLs itself.
NEXT_PUBLIC_BASE_PATH=/procurement

NODE_ENV=production
PORT=3002
