# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but DO track the documented template.
!.env.example

# local crawler recon artifacts (raw scraped HTML + ephemeral session tokens)
/recon/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Test fixtures generated from the user's real Pipeline workbook.
# pipeline-2026-rows.json is a verbatim capture of the "Agency/POC" cells and
# therefore holds 53 real government contact email addresses and 24 phone
# numbers belonging to named procurement officers. That is other people's
# personal data: it must not enter git history, where deleting it later does
# not remove it. Regenerate locally from the workbook instead — the spreadsheet
# on the operator's machine is the source of truth, and the department tests
# skip cleanly when the fixture is absent.
scripts/fixtures/
